#ifndef SHADER_BINDINGS
#define SHADER_BINDINGS
#include "shader-bindings.def"
#define VC_CONCAT_IMPL(a,b) a##b
#define VC_CONCAT(a,b) VC_CONCAT_IMPL(a,b)
#define VC_FRAME_REGISTER VC_CONCAT(b,VC_FRAME_SLOT)
#define VC_SECTION_REGISTER VC_CONCAT(b,VC_SECTION_SLOT)
#define VC_COVERAGE_REGISTER VC_CONCAT(t,VC_COVERAGE_SLOT)
#define VC_STEADY_REGISTER VC_CONCAT(t,VC_STEADY_SLOT)
#define VC_ANIMATED_REGISTER VC_CONCAT(t,VC_ANIMATED_SLOT)
#define VC_DETAIL_REGISTER VC_CONCAT(t,VC_DETAIL_SLOT)
#define VC_PANORAMA_SAMPLER_REGISTER VC_CONCAT(s,VC_PANORAMA_SAMPLER_SLOT)
#endif
