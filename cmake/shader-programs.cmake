# Build and loader consume one native, preprocessor-compatible catalog.
function(vaporcruise_shader_dependencies source output)
    get_filename_component(absolute "${source}" ABSOLUTE)
    set(result "${absolute}")
    file(STRINGS "${absolute}" includes REGEX "^[ \t]*#include[ \t]+\"")
    get_filename_component(directory "${absolute}" DIRECTORY)
    foreach(line IN LISTS includes)
        string(REGEX REPLACE ".*#include[ \t]+\"([^\"]+)\".*" "\\1" relative "${line}")
        vaporcruise_shader_dependencies("${directory}/${relative}" nested)
        list(APPEND result ${nested})
    endforeach()
    list(REMOVE_DUPLICATES result)
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

set(catalog "${CMAKE_SOURCE_DIR}/src/render/shader-programs.def")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${catalog}")
file(STRINGS "${catalog}" programs REGEX "^VC_PROGRAM")
set(outputs)
set(embed "// Generated from shader-programs.def.\n")
foreach(program IN LISTS programs)
    string(REGEX MATCH "VC_PROGRAM\\(([A-Za-z]+), \"([^\"]+)\", \"([^\"]+)\", \"([^\"]+)\", \"([^\"]+)\", ([A-Za-z_]+), \"([^\"]*)\"\\)" matched "${program}")
    if(NOT matched)
        message(FATAL_ERROR "Malformed shader program: ${program}")
    endif()
    set(source "${CMAKE_MATCH_2}")
    set(profile "${CMAKE_MATCH_3}")
    set(entry "${CMAKE_MATCH_4}")
    set(header "${CMAKE_MATCH_5}")
    set(symbol "${CMAKE_MATCH_6}")
    set(declared "${CMAKE_MATCH_7}")
    vaporcruise_shader_dependencies("${VAPORCRUISE_SHADER_DIR}/${source}" dependencies)
    foreach(dependency IN LISTS declared)
        list(APPEND dependencies "${VAPORCRUISE_SHADER_DIR}/${dependency}")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${dependencies})
    add_custom_command(OUTPUT "${VAPORCRUISE_GENERATED_SHADER_DIR}/${header}"
        COMMAND "${FXC_EXECUTABLE}" /nologo /T "${profile}" /E "${entry}"
            /Fh "${VAPORCRUISE_GENERATED_SHADER_DIR}/${header}" /Vn "${symbol}" "${VAPORCRUISE_SHADER_DIR}/${source}"
        DEPENDS ${dependencies} "${catalog}" VERBATIM)
    list(APPEND outputs "${VAPORCRUISE_GENERATED_SHADER_DIR}/${header}")
    string(APPEND embed "#include \"${header}\"\n")
endforeach()
file(CONFIGURE OUTPUT "${VAPORCRUISE_GENERATED_SHADER_DIR}/embedded-shaders.h" CONTENT "${embed}" @ONLY)
add_custom_target(VaporCruiseShaders DEPENDS ${outputs})
