# Git is optional for developer/source-archive builds. Release packaging requires
# a known clean repository identity, including nonignored untracked inputs.
function(vaporcruise_read_source_identity SOURCE_ROOT REVISION_OUTPUT STATE_OUTPUT)
    set(SOURCE_REVISION "")
    set(SOURCE_STATE "unknown")
    find_program(VAPORCRUISE_GIT_EXECUTABLE NAMES git NO_CACHE)
    if(VAPORCRUISE_GIT_EXECUTABLE AND IS_DIRECTORY "${SOURCE_ROOT}")
        execute_process(COMMAND "${VAPORCRUISE_GIT_EXECUTABLE}" -C "${SOURCE_ROOT}" rev-parse --show-toplevel
            RESULT_VARIABLE ROOT_RESULT OUTPUT_VARIABLE GIT_ROOT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(ROOT_RESULT EQUAL 0)
            file(REAL_PATH "${SOURCE_ROOT}" SOURCE_REAL_ROOT)
            file(REAL_PATH "${GIT_ROOT}" GIT_REAL_ROOT)
            if(WIN32)
                string(TOLOWER "${SOURCE_REAL_ROOT}" SOURCE_REAL_ROOT)
                string(TOLOWER "${GIT_REAL_ROOT}" GIT_REAL_ROOT)
            endif()
            if(SOURCE_REAL_ROOT STREQUAL GIT_REAL_ROOT)
                execute_process(COMMAND "${VAPORCRUISE_GIT_EXECUTABLE}" -C "${SOURCE_ROOT}" rev-parse --verify HEAD
                    RESULT_VARIABLE REVISION_RESULT OUTPUT_VARIABLE GIT_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
                string(LENGTH "${GIT_REVISION}" REVISION_LENGTH)
                if(REVISION_RESULT EQUAL 0 AND GIT_REVISION MATCHES "^[0-9a-fA-F]+$" AND
                   (REVISION_LENGTH EQUAL 40 OR REVISION_LENGTH EQUAL 64))
                    execute_process(COMMAND "${VAPORCRUISE_GIT_EXECUTABLE}" -C "${SOURCE_ROOT}" status --porcelain --untracked-files=normal
                        RESULT_VARIABLE STATUS_RESULT OUTPUT_VARIABLE GIT_STATUS OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
                    set(SOURCE_REVISION "${GIT_REVISION}")
                    if(STATUS_RESULT EQUAL 0)
                        if(GIT_STATUS STREQUAL "")
                            set(SOURCE_STATE "clean")
                        else()
                            set(SOURCE_STATE "dirty")
                        endif()
                    endif()
                endif()
            endif()
        endif()
    endif()
    set(${REVISION_OUTPUT} "${SOURCE_REVISION}" PARENT_SCOPE)
    set(${STATE_OUTPUT} "${SOURCE_STATE}" PARENT_SCOPE)
endfunction()
